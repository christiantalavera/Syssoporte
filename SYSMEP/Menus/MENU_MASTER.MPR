SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _7ck0k6fet OF _MSYSMENU PROMPT "Sistema" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _7ck0k6feu OF _MSYSMENU PROMPT "Aplicaciones" COLOR SCHEME 3 ;
	KEY ALT+A, ""
DEFINE PAD _7ck0k6fev OF _MSYSMENU PROMPT "Utilitarios" COLOR SCHEME 3 ;
	KEY ALT+U, ""
ON PAD _7ck0k6fet OF _MSYSMENU ACTIVATE POPUP sistema
ON PAD _7ck0k6feu OF _MSYSMENU ACTIVATE POPUP aplicacion
ON PAD _7ck0k6fev OF _MSYSMENU ACTIVATE POPUP utilitario

DEFINE POPUP sistema MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF sistema PROMPT "Cambia Año"
DEFINE BAR 2 OF sistema PROMPT "Salir"
ON SELECTION BAR 1 OF sistema ;
	DO _7ck0k6few ;
	IN LOCFILE("SYSMEP\MENUS\MENU_MASTER" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_MASTER?")
ON SELECTION BAR 2 OF sistema ;
	DO _7ck0k6fex ;
	IN LOCFILE("SYSMEP\MENUS\MENU_MASTER" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_MASTER?")

DEFINE POPUP aplicacion MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF aplicacion PROMPT "Modificar Código del Convenio Masivo V1"
DEFINE BAR 2 OF aplicacion PROMPT "Modificar Código del Convenio Masivo por Meta"
DEFINE BAR 3 OF aplicacion PROMPT "Procesar XML SIAF"
ON SELECTION BAR 1 OF aplicacion do form frmmodifica_convenio_masivo
ON SELECTION BAR 2 OF aplicacion do form frmmodifica_convenio_meta_masivo
ON SELECTION BAR 3 OF aplicacion do form frmprocesardataxml

DEFINE POPUP utilitario MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF utilitario PROMPT "Reindexar Archivos"
DEFINE BAR 2 OF utilitario PROMPT "Eliminación Física de Registros"
DEFINE BAR 3 OF utilitario PROMPT "Actualizar Tipo de Aporte"
DEFINE BAR 4 OF utilitario PROMPT "Actualizar Descripcion del Pago"
ON SELECTION BAR 1 OF utilitario ;
	DO _7ck0k6fey ;
	IN LOCFILE("SYSMEP\MENUS\MENU_MASTER" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_MASTER?")
ON SELECTION BAR 2 OF utilitario ;
	DO _7ck0k6fez ;
	IN LOCFILE("SYSMEP\MENUS\MENU_MASTER" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_MASTER?")
ON SELECTION BAR 3 OF utilitario do actualiza_tipo_aporte
ON SELECTION BAR 4 OF utilitario DO actualizar_descripcion_pago


