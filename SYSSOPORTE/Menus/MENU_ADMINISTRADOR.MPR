SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _7d70j56cl OF _MSYSMENU PROMPT "Sistema" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _7d70j56cm OF _MSYSMENU PROMPT "Mantenimiento" COLOR SCHEME 3 ;
	KEY ALT+M, ""
DEFINE PAD _7d70j56cn OF _MSYSMENU PROMPT "Aplicaciones" COLOR SCHEME 3 ;
	KEY ALT+A, ""
DEFINE PAD _7d70j56co OF _MSYSMENU PROMPT "Utilitarios" COLOR SCHEME 3 ;
	KEY ALT+U, ""
ON PAD _7d70j56cl OF _MSYSMENU ACTIVATE POPUP sistema
ON PAD _7d70j56cm OF _MSYSMENU ACTIVATE POPUP mantenimie
ON PAD _7d70j56cn OF _MSYSMENU ACTIVATE POPUP newitem
ON PAD _7d70j56co OF _MSYSMENU ACTIVATE POPUP utilitario

DEFINE POPUP sistema MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF sistema PROMPT "Cambia Año"
DEFINE BAR 2 OF sistema PROMPT "Salir"
ON SELECTION BAR 1 OF sistema ;
	DO _7d70j56cp ;
	IN LOCFILE("SYSSOPORTE\MENUS\MENU_ADMINISTRADOR" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_ADMINISTRADOR?")
ON SELECTION BAR 2 OF sistema ;
	DO _7d70j56cq ;
	IN LOCFILE("SYSSOPORTE\MENUS\MENU_ADMINISTRADOR" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_ADMINISTRADOR?")

DEFINE POPUP mantenimie MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF mantenimie PROMPT "Mantenimiento de Usuarios"
ON SELECTION BAR 1 OF mantenimie do form frmmenutree

DEFINE POPUP newitem MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF newitem PROMPT "Procesar XML SIAF"
ON SELECTION BAR 1 OF newitem do form frmprocesardataxml

DEFINE POPUP utilitario MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF utilitario PROMPT "Reindexa Archivos"
DEFINE BAR 2 OF utilitario PROMPT "Eliminación Fisica de Registros"
DEFINE BAR 3 OF utilitario PROMPT "Actualizar Menus (XML)"
DEFINE BAR 4 OF utilitario PROMPT "Actualiza año (INI)"
DEFINE BAR 5 OF utilitario PROMPT "Copiar Menus por Año"
ON SELECTION BAR 1 OF utilitario Do sf_reindexa in utilitarios.prg
ON SELECTION BAR 2 OF utilitario Do sf_packea in utilitarios
ON SELECTION BAR 3 OF utilitario Do procesa_menu
ON SELECTION BAR 4 OF utilitario do actualiza_ano_ini
ON SELECTION BAR 5 OF utilitario DO FORM frmcopiamenu_x_ano


