DEFINE PAD _7d70j5a91 OF _MSYSMENU PROMPT "Sistema" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _7d70j5a92 OF _MSYSMENU PROMPT "Aplicaciones" COLOR SCHEME 3 ;
	KEY ALT+A, ""
DEFINE PAD _7d70j5a93 OF _MSYSMENU PROMPT "Mantenimiento" COLOR SCHEME 3 ;
	KEY ALT+M, ""
DEFINE PAD _7d70j5a94 OF _MSYSMENU PROMPT "Utilitarios" COLOR SCHEME 3 ;
	KEY ALT+U, ""
ON PAD _7d70j5a91 OF _MSYSMENU ACTIVATE POPUP sistema
ON PAD _7d70j5a92 OF _MSYSMENU ACTIVATE POPUP aplicacion
ON PAD _7d70j5a93 OF _MSYSMENU ACTIVATE POPUP mantenimie
ON PAD _7d70j5a94 OF _MSYSMENU ACTIVATE POPUP utilitario

DEFINE POPUP sistema MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF sistema PROMPT "Cambia Año"
DEFINE BAR 2 OF sistema PROMPT "Salir"
ON SELECTION BAR 1 OF sistema ;
	DO _7d70j5a95 ;
	IN LOCFILE("SYSSOPORTE\MENUS\MENU_ADMINISTRADOR_MASTER" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_ADMINISTRADOR_MASTER?")
ON SELECTION BAR 2 OF sistema ;
	DO _7d70j5a96 ;
	IN LOCFILE("SYSSOPORTE\MENUS\MENU_ADMINISTRADOR_MASTER" ,"MPX;MPR|FXP;PRG" ,"WHERE is MENU_ADMINISTRADOR_MASTER?")

DEFINE POPUP aplicacion MARGIN RELATIVE SHADOW COLOR SCHEME 4
